# Envío del formulario de contacto (Server Action con nodemailer)
# Copia este fichero a .env.local y rellena los valores reales.
SMTP_HOST=smtp.tu-proveedor.com
SMTP_PORT=587
SMTP_USER=web@goodparty.es
SMTP_PASS=tu-password-o-app-password
# Buzón que recibe las solicitudes
CONTACT_TO=info@goodparty.es
# Remitente que aparece en el correo
CONTACT_FROM=TerrorPlay <web@goodparty.es>

# URL pública del sitio (para sitemap, robots y Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.terrorplay.com
