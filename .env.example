# ---------------------------------------------------------------------------
# Envío del formulario de contacto (Server Action con nodemailer)
# Copia este fichero a .env.local para desarrollo. NUNCA subas .env.local a git.
# En producción, define estas variables en Vercel (Settings > Environment Variables).
# ---------------------------------------------------------------------------

# Correo de TerrorPlay (Dinaserver)
SMTP_HOST=terrorplay-com.correoseguro.dinaserver.com
# 465 = SMTPS (recomendado). La alternativa es 587 con STARTTLS.
SMTP_PORT=465
SMTP_USER=info@terrorplay.com
SMTP_PASS=la-contrasena-del-buzon

# Buzón que recibe las solicitudes del formulario
CONTACT_TO=info@terrorplay.com
# Remitente que aparece en el correo (debe ser la misma cuenta que SMTP_USER)
CONTACT_FROM=TerrorPlay <info@terrorplay.com>

# URL pública del sitio (canonicals, sitemap y Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.terrorplay.com
